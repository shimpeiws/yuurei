node_modules/
dist/
*.tsbuildinfo

/.yuurei/runs/
examples/*/.yuurei/runs/

*.local
.DS_Store
.verification/
.worktrees/

# .claude/agents/ is committed; local session state is not.
.claude/*.lock
.claude/settings.local.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
# Unanchored: the indexer writes a `graft/` next to whatever directory it is
# invoked from, not only at the repository root.
graft/

# graft per-developer wiring (optional tool; each developer runs `graft init` locally).
.claude/settings.json
.claude/helpers/
.claude/skills/graft/
.mcp.json
opencode.json
.ignore
