{
  "name": "yuurei",
  "version": "0.0.1",
  "description": "Isolated, reproducible runtime environments for coding agents (Claude Code, Codex).",
  "homepage": "https://github.com/shimpeiws/yuurei#readme",
  "bugs": {
    "url": "https://github.com/shimpeiws/yuurei/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shimpeiws/yuurei.git"
  },
  "bin": {
    "yuurei": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "oxlint --deny-warnings",
    "check:fix": "oxlint --deny-warnings --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "knip": "knip",
    "smoke:package": "pnpm run build && node scripts/smoke-package.mjs",
    "prepublishOnly": "pnpm run smoke:package",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "yaml": "^2.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^22.0.0",
    "knip": "^6.0.0",
    "lefthook": "^2.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "packageManager": "pnpm@11.6.0"
}
